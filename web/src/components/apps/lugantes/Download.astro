---
import { config } from '../../../data/apps/lugantes';
---
<section id="download" class="download">
  <div class="container">
    <h2>Descarga Lugantes</h2>
    <p>Disponible para Android. iOS en evaluación.</p>
    {config.playStoreReady ? (
      <a href={config.playStoreUrl} class="badge">
        <span class="play">▶</span>
        <span class="text">
          <small>DISPONIBLE EN</small>
          <strong>Google Play</strong>
        </span>
      </a>
    ) : (
      <div class="soon">
        <span class="dot"></span>
        <span>Próximamente — únete a la beta</span>
      </div>
    )}
  </div>
</section>

<style>
  .download {
    padding: 4rem 0;
    text-align: center;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--primary) 6%, transparent));
  }
  .container { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
  h2 { font-size: 2rem; color: var(--text-strong); margin-bottom: 0.4rem; }
  p { color: var(--text-muted); margin-bottom: 2rem; }
  .badge {
    display: inline-flex; align-items: center; gap: 0.8rem;
    padding: 0.9rem 1.6rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #0b0712;
    border-radius: 12px;
    font-weight: 700;
  }
  .badge:hover { text-decoration: none; transform: translateY(-2px); }
  .play { font-size: 1.4rem; }
  .text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; }
  .text small { font-size: 0.7rem; opacity: 0.8; }
  .text strong { font-size: 1.1rem; }
  .soon {
    display: inline-flex; gap: 0.6rem; align-items: center;
    padding: 0.9rem 1.6rem;
    background: var(--bg-elevated);
    border: 1px dashed var(--border);
    border-radius: 12px;
    color: var(--text-muted);
  }
  .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
</style>
