---
import { config } from '../../../data/apps/lugantes';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="grid">
      <div>
        <h4>{config.name}</h4>
        <p>{config.tagline}</p>
      </div>
      <div>
        <h5>Producto</h5>
        <a href="/apps/lugantes#features">Características</a>
        <a href="/apps/lugantes#download">Descargar</a>
      </div>
      <div>
        <h5>Legal</h5>
        <a href="/apps/lugantes/privacidad">Privacidad</a>
        <a href="/apps/lugantes/terminos">Términos</a>
      </div>
      <div>
        <h5>Contacto</h5>
        <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a>
        <a href={config.publisherUrl}>{config.publisher}</a>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {config.publisher}</span>
      <span>Hecho en LATAM</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 3rem 0 2rem; margin-top: 4rem; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } }
  h4 { color: var(--text-strong); margin-bottom: 0.5rem; }
  h5 { color: var(--text-strong); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; }
  .grid p { color: var(--text-muted); font-size: 0.9rem; }
  .grid a { display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.4rem; }
  .grid a:hover { color: var(--accent); text-decoration: none; }
  .bottom {
    display: flex; justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
