      .hook-form button:hover { background: var(--ink); }
      .hook-form button:disabled { opacity: 0.6; cursor: not-allowed; }
      .hook-status { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-ink); min-height: 1rem; }
      .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

      .foot { margin-top: clamp(3rem, 6vw, 4.5rem); margin-bottom: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .foot p { color: var(--ink-soft); font-size: 0.88rem; flex: 1; min-width: 200px; }
      .foot-mono { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; color: var(--ink-soft); }

      a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

      .brand-mark { display: inline-flex; color: var(--accent-ink); }
      .brand-mark svg { width: 20px; height: 20px; }
      .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
      .ic { position: absolute; top: 9px; right: 9px; width: 32px; height: 32px; display: grid; place-items: center; color: var(--accent-ink); background: var(--paper); border: 1px solid var(--line); z-index: 2; transition: border-color 0.18s, background 0.18s; }
      .ic svg { width: 18px; height: 18px; }
      .card:hover .ic { border-color: var(--accent); background: var(--accent-soft); }
      .step-top { display: flex; align-items: center; justify-content: space-between; }
      .step-ic { color: var(--accent-ink); display: inline-flex; }
      .step-ic svg { width: 20px; height: 20px; }

      .section-lead { font-size: 1.02rem; color: var(--ink-soft); max-width: 60ch; margin-top: 0.9rem; text-wrap: pretty; }

      .ba { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: clamp(0.9rem, 2.5vw, 1.8rem); margin-top: 1.8rem; }
      .ba-panel { border: 1px solid var(--line); padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; gap: 1rem; }
      .ba-then { background: var(--paper-2); }
      .ba-now { background: #fff; border-color: var(--ink); box-shadow: 8px 8px 0 var(--ink); }
      .ba-label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
      .ba-now .ba-label { color: var(--accent-ink); }
      .ba-note { font-size: 0.85rem; color: var(--ink-soft); margin-top: auto; }
      .ba-arrow { align-self: center; font-family: var(--font-mono); font-size: 1.5rem; color: var(--accent-ink); }

      .then-sheet { position: relative; display: flex; flex-direction: column; gap: 0.75rem; min-height: 118px; padding: 0.3rem 0; }
      .scrawl { height: 9px; background: #c6c3b8; border-radius: 5px; opacity: 0.75; }
      .then-sheet .scrawl:nth-child(1) { transform: rotate(-1.2deg); }
      .then-sheet .scrawl:nth-child(3) { transform: rotate(0.8deg); }
      .then-sheet .scrawl:nth-child(4) { transform: rotate(-0.6deg); }
      .scrawl.strike { position: relative; }
      .scrawl.strike::after { content: ''; position: absolute; left: -4%; right: -4%; top: 50%; height: 2px; background: #a8563f; transform: rotate(-2.5deg); }
      .qmark { position: absolute; right: 4px; bottom: 0; font-family: var(--font-mono); font-size: 1.7rem; font-weight: 700; color: #b3b0a4; }

      .now-app { display: flex; flex-direction: column; gap: 0.6rem; min-height: 118px; }
      .nrow { display: flex; align-items: center; gap: 0.7rem; }
      .nbar { height: 10px; background: var(--accent); opacity: 0.28; border-radius: 3px; }
      .nrow b { margin-left: auto; font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink); font-variant-numeric: tabular-nums; }
      .ndot { flex: none; width: 9px; height: 9px; border-radius: 50%; }
      .ndot.ok { background: var(--accent); }
      .ndot.warn { background: var(--warn); }
      .nfoot { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; padding-top: 0.65rem; border-top: 1px dashed var(--line); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--warn); }

      .ba-caption { grid-column: 1 / -1; margin-top: 0.3rem; display: flex; flex-direction: column; gap: 0.3rem; }
      .ba-cap-name { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
      .ba-caption p { font-size: 0.98rem; color: var(--ink); max-width: 58ch; }

      .types { margin-top: clamp(2.2rem, 4vw, 3.2rem); }
      .types-label { display: block; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 0.6rem; }
      .type-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 0 1.8rem; }
      .type { display: flex; align-items: center; gap: 0.85rem; padding: 0.95rem 0; border-bottom: 1px solid var(--line); }
      .type-ic { flex: none; width: 36px; height: 36px; display: grid; place-items: center; color: var(--accent-ink); border: 1px solid var(--line); background: #fff; transition: border-color 0.15s, background 0.15s; }
      .type-ic svg { width: 19px; height: 19px; }
      .type:hover .type-ic { border-color: var(--accent); background: var(--accent-soft); }
      .type-txt { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
      .type-txt b { font-size: 0.98rem; letter-spacing: -0.01em; }
      .type-txt em { font-style: normal; font-size: 0.83rem; color: var(--ink-soft); }

      .casos { margin-top: 0; }
      .case-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }
      .case-card { border: 1px solid var(--line); background: #fff; padding: 1.3rem 1.3rem 1.4rem; display: flex; gap: 1rem; align-items: flex-start; transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s; }
      .case-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 6px 6px 0 var(--accent); }
      .case-mark { flex: none; width: 34px; height: 34px; display: grid; place-items: center; color: #fff; background: var(--accent); }
      .case-mark svg { width: 20px; height: 20px; }
      .case-body { display: flex; flex-direction: column; gap: 0.45rem; }
      .case-body h3 { font-size: 1.08rem; letter-spacing: -0.01em; }
      .case-body p { font-size: 0.88rem; color: var(--ink-soft); }
      .case-link { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-ink); text-decoration: none; margin-top: 0.2rem; }
      .case-link:hover { text-decoration: underline; }

      .reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s ease; }
      .reveal.in { opacity: 1; transform: none; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .reveal { opacity: 1; transform: none; transition: none; }
        [data-par] { transform: none !important; }
      }
      @media (max-width: 760px) {
        .ba { grid-template-columns: 1fr; }
        .ba-arrow { transform: rotate(90deg); justify-self: center; }
      }
      @media (max-width: 860px) {
        .hero-inner { grid-template-columns: 1fr; }
        .hero-visual { margin-top: 2.5rem; }
        .grid { grid-template-columns: repeat(2, 1fr); }
        .steps { grid-template-columns: 1fr; }
        .hook { grid-template-columns: 1fr; }
      }
      @media (max-width: 560px) {
        .brand-sub { display: none; }
        .nav { gap: 0.8rem; }
        .nav a:not(.nav-cta):not(.lang-toggle) { display: none; }
        .grid { grid-template-columns: 1fr; }
        .case-grid { grid-template-columns: 1fr; }
        .hook-row { grid-template-columns: 1fr; }
        .strip-inner { flex-direction: column; align-items: flex-start; }
        .float-chip { display: none; }
      }
    </style>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const money = (v) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Math.round(v));
      const salary = document.getElementById('mini-salary');
      const hours = document.getElementById('mini-hours');
      const out = document.getElementById('mini-value');
      const chipVal = document.getElementById('chip-val');
      function recalc() {
        const s = parseFloat(salary.value) || 0;
        const h = parseFloat(hours.value) || 0;
        const val = (s / 240) * h * 0.9;
        out.textContent = money(val);
        chipVal.textContent = money(val);
      }
      salary.addEventListener('input', recalc);
      hours.addEventListener('input', recalc);
      recalc();

      const grid = document.getElementById('grid');
      document.getElementById('filters').addEventListener('click', (e) => {
        const btn = e.target.closest('.chip');
        if (!btn) return;
        document.querySelectorAll('#filters .chip').forEach((c) => c.classList.toggle('is-active', c === btn));
        const f = btn.dataset.filter;
        grid.querySelectorAll('.card').forEach((card) => card.classList.toggle('is-hidden', f !== 'all' && card.dataset.sector !== f));
      });

      const hookForm = document.getElementById('hook-form');
      const hookStatus = document.getElementById('hook-status');
      hookForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = hookForm.querySelector('button');
        button.disabled = true;
        hookStatus.textContent = hookForm.dataset.sending;
        try {
          const el = hookForm.elements;
          const topic = el['sector'].value.trim();
          const payload = {
            name: el['name'].value,
            email: el['email'].value,
            subject: topic || 'Contacto del sitio',
            message: el['message'].value,
            company: el['company'].value,
          };
          const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const data = await res.json();
          hookStatus.textContent = res.ok && data.ok ? (hookForm.reset(), hookForm.dataset.ok) : hookForm.dataset.fail;
        } catch {
          hookStatus.textContent = hookForm.dataset.fail;
        } finally {
          button.disabled = false;
        }
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      if (!reduce) {
        const layers = [...document.querySelectorAll('[data-par]')];
        const hero = document.querySelector('.hero');
        let px = 0, py = 0, scy = 0, raf = 0;
        function apply() {
          raf = 0;
          for (const l of layers) {
            const f = parseFloat(l.dataset.par);
            l.style.transform = `translate3d(${(px * f * 16).toFixed(1)}px, ${(py * f * 16 - scy * f * 0.1).toFixed(1)}px, 0)`;
          }
        }
        function schedule() { if (!raf) raf = requestAnimationFrame(apply); }
        hero.addEventListener('pointermove', (e) => {
          const r = hero.getBoundingClientRect();
          px = (e.clientX - r.left) / r.width - 0.5;
          py = (e.clientY - r.top) / r.height - 0.5;
          schedule();
        });
        window.addEventListener('scroll', () => { scy = window.scrollY; schedule(); }, { passive: true });

        const hc = document.getElementById('heroCanvas');
        const hx = hc.getContext('2d');
        let W, H, dpr, t = 0;
        function size() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = hc.clientWidth; H = hc.clientHeight;
          hc.width = W * dpr; hc.height = H * dpr; hx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        size();
        window.addEventListener('resize', size);
        const gap = 34;
        function draw() {
          hx.clearRect(0, 0, W, H);
          const off = (t * 0.25) % gap;
          hx.fillStyle = 'rgba(23,32,27,0.05)';
          for (let x = -gap; x < W + gap; x += gap) for (let y = -gap; y < H + gap; y += gap) { hx.fillRect(x + off, y + off, 1.4, 1.4); }
          hx.strokeStyle = 'rgba(15,110,78,0.16)'; hx.lineWidth = 1.4; hx.beginPath();
          for (let x = 0; x <= W; x += 6) {
            const y = H * 0.5 + Math.sin(x * 0.006 + t * 0.02) * 26 + Math.sin(x * 0.013 + t * 0.03) * 12;
            x === 0 ? hx.moveTo(x, y) : hx.lineTo(x, y);
          }
          hx.stroke();
          t += 1;
          requestAnimationFrame(draw);
        }
        draw();

        const sc = document.getElementById('stripCanvas');
        if (sc) {
          const sx = sc.getContext('2d');
          let SW, SH, st = 0;
          function ssize() { const d = Math.min(window.devicePixelRatio || 1, 2); SW = sc.clientWidth; SH = sc.clientHeight; sc.width = SW * d; sc.height = SH * d; sx.setTransform(d, 0, 0, d, 0, 0); }
          ssize(); window.addEventListener('resize', ssize);
          function sdraw() {
            sx.clearRect(0, 0, SW, SH);
            const g = 26; const off = (st * 0.2) % g;
            sx.strokeStyle = 'rgba(127,216,180,0.10)'; sx.lineWidth = 1;
            for (let x = -g; x < SW + g; x += g) { sx.beginPath(); sx.moveTo(x + off, 0); sx.lineTo(x + off, SH); sx.stroke(); }
            st += 1; requestAnimationFrame(sdraw);
          }
          sdraw();
        }
      }
    </script>
  </body>
</html>
