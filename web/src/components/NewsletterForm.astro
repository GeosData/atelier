---
/**
 * NewsletterForm.astro — componente reutilizable
 *
 * Usar en cualquier brand site Astro del ecosistema Josse.
 * Posts a Listmonk public endpoint, double opt-in.
 *
 * Ejemplo:
 *   <NewsletterForm
 *     listUuid="706f4a79-9254-43fa-b185-5a48c1bc5c46"
 *     brandName="Jotive Dev"
 *     description="Bitacora dev semanal. Sin spam."
 *   />
 *
 * Listmonk endpoint: https://newsletter.geosdata.com
 * UUIDs por brand: ver newsletter-stack/lists.env
 */

interface Props {
  listUuid: string;
  brandName?: string;
  ctaText?: string;
  placeholder?: string;
  description?: string;
  endpoint?: string;
  accent?: string;
}

const {
  listUuid,
  brandName = 'Newsletter',
  ctaText = 'Suscribirme',
  placeholder = 'tu@email.com',
  description = '',
  endpoint = 'https://newsletter.geosdata.com/api/public/subscription',
  accent = '#0066cc',
} = Astro.props;

const formId = `nl-${listUuid.slice(0, 8)}`;
---

<form
  id={formId}
  class="newsletter-form"
  data-endpoint={endpoint}
  data-list-uuid={listUuid}
  novalidate
>
  {brandName && <h3 class="nl-title">{brandName}</h3>}
  {description && <p class="nl-desc">{description}</p>}

  <div class="nl-row">
    <input
      type="email"
      name="email"
      placeholder={placeholder}
      required
      autocomplete="email"
      class="nl-input"
    />
    <button type="submit" class="nl-button">{ctaText}</button>
  </div>

  <p class="nl-status" role="status" aria-live="polite"></p>
</form>

<style define:vars={{ accent }}>
  .newsletter-form {
    max-width: 520px;
    margin: 0 auto;
    font-family: inherit;
  }
  .nl-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .nl-desc {
    font-size: 0.9rem;
    color: #666;
    margin: 0 0 1rem;
  }
  .nl-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1 1 240px;
    padding: 0.65rem 0.85rem;
    font-size: 1rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
    transition: border-color 0.15s;
  }
  .nl-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .nl-button {
    padding: 0.65rem 1.25rem;
    font-size: 1rem;
    font-weight: 500;
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .nl-button:hover:not(:disabled) { opacity: 0.9; }
  .nl-button:disabled { opacity: 0.5; cursor: wait; }
  .nl-status {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    min-height: 1.25rem;
  }
  .nl-status.ok { color: #2a8c5a; }
  .nl-status.err { color: #c62828; }
  @media (prefers-color-scheme: dark) {
    .nl-input { background: #1a1a1a; color: #f0f0f0; border-color: #444; }
    .nl-desc { color: #aaa; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form.newsletter-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.nl-status')!;
    const input = form.querySelector<HTMLInputElement>('.nl-input')!;
    const button = form.querySelector<HTMLButtonElement>('.nl-button')!;
    const endpoint = form.dataset.endpoint!;
    const listUuid = form.dataset.listUuid!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      status.className = 'nl-status';
      status.textContent = 'Enviando...';
      button.disabled = true;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, list_uuids: [listUuid] }),
        });

        if (res.ok) {
          status.className = 'nl-status ok';
          status.textContent = 'Revisa tu email para confirmar la suscripcion.';
          input.value = '';
        } else {
          const data = await res.json().catch(() => ({}));
          status.className = 'nl-status err';
          status.textContent = data?.message || 'No se pudo procesar. Intenta de nuevo.';
        }
      } catch {
        status.className = 'nl-status err';
        status.textContent = 'Error de red. Verifica tu conexion.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
