---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Recupera el talento de tu equipo. Automatizamos tareas repetitivas para que se enfoquen en lo importante. Desde reportes automáticos hasta apps que organizan tu operación." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://geosdata.com/products" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Servicios - GeosData" />
    <meta property="og:description" content="Recupera el talento de tu equipo. Automatizamos lo repetitivo para que se enfoquen en lo importante." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://geosdata.com/products" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>GeosData - Servicios</title>
  </head>
  <body>
    <Header currentPage="products" />
    
    <main class="main">
      <section class="page-hero">
        <div class="hero-glow"></div>
        <div class="container">
          <h1 class="page-title">Nuestros Productos Digitales</h1>
          <p class="page-subtitle">
            Soluciones digitales propias, enfocadas en lo práctico y lo disfrutable
          </p>
        </div>
      </section>

      <section class="services-detailed">
        <div class="container">
          <div class="services-grid">
            <div class="service-card">
              <div class="service-icon-wrapper blue">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"/>
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
              </div>
              <h3 class="service-title">Micro SaaS</h3>
              <p class="service-description">
                Herramientas simples para el día a día que resuelven problemas específicos de manera elegante y práctica.
              </p>
              <ul class="service-features">
                <li>Herramientas de productividad</li>
                <li>Gestión de tareas simples</li>
                <li>Utilidades para desarrolladores</li>
                <li>Herramientas de análisis básico</li>
              </ul>
            </div>

            <div class="service-card">
              <div class="service-icon-wrapper purple">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                  <path d="M12 18h.01"/>
                </svg>
              </div>
              <h3 class="service-title">Aplicaciones Móviles</h3>
              <p class="service-description">
                Apps diseñadas para usarse y mantenerse, con interfaces intuitivas y funcionalidades prácticas.
              </p>
              <ul class="service-features">
                <li>Apps de productividad</li>
                <li>Herramientas de hábitos</li>
                <li>Aplicaciones educativas</li>
                <li>Utilidades cotidianas</li>
              </ul>
            </div>

            <div class="service-card">
              <div class="service-icon-wrapper pink">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 6H3"/>
                  <path d="M10 12H3"/>
                  <path d="M10 18H3"/>
                  <circle cx="17" cy="15" r="3"/>
                  <path d="m21 19-1.9-1.9"/>
                </svg>
              </div>
              <h3 class="service-title">Videojuegos</h3>
              <p class="service-description">
                Experiencias de entretenimiento accesible que combinan diversión con diseño cuidadoso y mecánicas simples.
              </p>
              <ul class="service-features">
                <li>Juegos indie minimalistas</li>
                <li>Experiencias narrativas</li>
                <li>Puzzles y rompecabezas</li>
                <li>Juegos educativos</li>
              </ul>
            </div>

            <div class="service-card">
              <div class="service-icon-wrapper emerald">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              </div>
              <h3 class="service-title">Plataformas Educativas</h3>
              <p class="service-description">
                Espacios de aprendizaje digital que hacen el conocimiento más accesible, atractivo y fácil de digerir.
              </p>
              <ul class="service-features">
                <li>Cursos interactivos</li>
                <li>Plataformas de práctica</li>
                <li>Herramientas de evaluación</li>
                <li>Recursos de aprendizaje</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="process-section">
        <div class="container">
          <h2 class="section-title">Nuestro Proceso</h2>
          <div class="process-steps">
            <div class="step">
              <div class="step-number">1</div>
              <h4 class="step-title">Análisis</h4>
              <p class="step-description">Entendemos tus necesidades y desafíos específicos</p>
            </div>
            <div class="step">
              <div class="step-number">2</div>
              <h4 class="step-title">Diseño</h4>
              <p class="step-description">Creamos una solución personalizada para tu caso</p>
            </div>
            <div class="step">
              <div class="step-number">3</div>
              <h4 class="step-title">Desarrollo</h4>
              <p class="step-description">Implementamos la solución con las mejores prácticas</p>
            </div>
            <div class="step">
              <div class="step-number">4</div>
              <h4 class="step-title">Entrega</h4>
              <p class="step-description">Te acompañamos en la implementación y optimización</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #030712;
    color: #94a3b8;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-hero {
    position: relative;
    padding: 8rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: rgba(99, 102, 241, 0.2);
    filter: blur(100px);
    border-radius: 50%;
    opacity: 0.5;
    pointer-events: none;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: white;
    position: relative;
    z-index: 1;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .services-detailed {
    padding: 4rem 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(30, 41, 59, 0.6);
    border-radius: 1.5rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-4px);
  }

  .service-icon-wrapper {
    width: fit-content;
    padding: 0.75rem;
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
  }

  .service-icon-wrapper.blue { color: #60a5fa; }
  .service-icon-wrapper.purple { color: #c084fc; }
  .service-icon-wrapper.pink { color: #f472b6; }
  .service-icon-wrapper.emerald { color: #34d399; }

  .service-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
  }

  .service-description {
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .service-features {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-features li {
    padding-left: 1.5rem;
    position: relative;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .service-features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    background: #4f46e5;
    border-radius: 50%;
  }

  .process-section {
    padding: 4rem 0 6rem;
    background: rgba(2, 6, 23, 0.5);
    border-top: 1px solid #0f172a;
  }

  .section-title {
    text-align: center;
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 3rem;
    color: white;
  }

  .process-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .process-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    text-align: center;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(30, 41, 59, 0.6);
    padding: 2rem;
    border-radius: 1.5rem;
    transition: all 0.3s ease;
  }

  .step:hover {
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-4px);
  }

  .step-number {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #4f46e5, #8b5cf6);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 auto 1.5rem;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: white;
  }

  .step-description {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 6rem 0 3rem;
    }
  }
</style>
