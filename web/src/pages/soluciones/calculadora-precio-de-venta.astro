---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';

const title = 'Calculadora de precio de venta y margen de ganancia';
const description = 'Calcula gratis a cómo vender tu producto: pon el costo y cuánto quieres ganar, y obtén el precio de venta, la ganancia y el margen real. Con opción de sumar IVA.';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://geosdata.com/soluciones/calculadora-precio-de-venta/" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <title>{title} · Geosdata</title>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="M3 13l9 5 9-5"/></svg></span>
          <span class="mark">GEOSDATA</span>
        </a>
        <a class="back" href="/">← Inicio</a>
      </header>

      <main class="tool">
        <section class="intro">
          <p class="eyebrow">Producto · precios</p>
          <h1>¿A cómo vender para ganar lo que quieres?</h1>
          <p class="lead">
            Poner el precio "a ojo" es donde más se pierde plata. Pon cuánto te cuesta el producto y cuánto quieres
            ganar, y obtén el precio de venta, la ganancia y el margen real, sin adivinar.
          </p>
        </section>

        <section class="calculator">
          <form id="price-form" class="rec-form" novalidate>
            <div class="field">
              <label for="cost">Costo del producto (COP)</label>
              <input type="number" id="cost" name="cost" min="0" step="100" placeholder="10000" required />
            </div>

            <div class="field">
              <label for="mode">Cómo defines la ganancia</label>
              <select id="mode" name="mode">
                <option value="markup" selected>Sobre el costo (le sumo un %)</option>
                <option value="margin">Sobre el precio de venta (margen)</option>
              </select>
            </div>

            <div class="field">
              <label for="pct">Porcentaje de ganancia (%)</label>
              <input type="number" id="pct" name="pct" min="0" step="1" placeholder="40" required />
            </div>

            <div class="field">
              <label for="iva">¿Sumar IVA al precio final?</label>
              <select id="iva" name="iva">
                <option value="no" selected>No</option>
                <option value="yes">Sí, IVA 19%</option>
              </select>
            </div>

            <button type="submit">Calcular</button>
          </form>

          <div id="price-result" class="rec-result" hidden></div>
        </section>

        <section id="hook" class="hook" hidden>
          <h2>¿Te sirvió?</h2>
          <p>
            Esto pone el precio de un producto. Si vendes muchos y quieres tu lista de precios, los márgenes y qué
            producto deja más, todo en un solo lugar, escríbeme y lo miramos.
          </p>
          <form id="hook-form" class="hook-form" novalidate>
            <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="hook-row">
              <input type="text" name="name" placeholder="Tu nombre" required />
              <input type="email" name="email" placeholder="tu@correo.com" required />
            </div>
            <textarea name="message" rows="3" placeholder="Cuéntame de tu negocio: qué vendes, cómo pones los precios hoy." required></textarea>
            <button type="submit">Escríbeme</button>
            <p id="hook-status" class="hook-status" role="status"></p>
          </form>
        </section>

        <section class="notes">
          <h2>Margen y markup no son lo mismo</h2>
          <ul>
            <li><strong>Sobre el costo (markup):</strong> le sumas un % a lo que te costó. Precio = costo × (1 + %).</li>
            <li><strong>Sobre el precio (margen):</strong> el % es qué parte del precio de venta es ganancia. Precio = costo ÷ (1 − %).</li>
            <li>Por eso un "40% sobre el costo" deja menos plata que un "40% de margen": conviene tener claro cuál usas.</li>
          </ul>
          <p class="disclaimer">
            Cálculo de matemática pura, sin datos externos. El IVA usa la tarifa general del 19%; algunos productos
            tienen tarifas distintas o están excluidos, y solo lo cobras si eres responsable de IVA. Esta herramienta te
            da el precio; el precio final también depende de tu competencia y de lo que el cliente está dispuesto a pagar.
          </p>
        </section>
      </main>

      <footer class="foot">
        <span class="mark">GEOSDATA</span>
        <p>Productos digitales enfocados en problemas comunes.</p>
        <span class="foot-mono">geosdata.com</span>
      </footer>
    </div>

    <script is:inline>
      const IVA = 0.19;

      const money = (value) =>
        new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Math.round(value));

      const pctFmt = (value) => `${value.toLocaleString('es-CO', { maximumFractionDigits: 1 })}%`;

      function renderResult(cost, mode, pct, addIva, result) {
        let price;
        if (mode === 'margin') {
          if (pct >= 100) {
            result.innerHTML = '<div class="line"><span>Un margen sobre el precio no puede ser 100% o más. Usa un valor menor.</span></div>';
            result.hidden = false;
            return;
          }
          price = cost / (1 - pct / 100);
        } else {
          price = cost * (1 + pct / 100);
        }

        const profit = price - cost;
        const markupReal = (profit / cost) * 100;
        const marginReal = (profit / price) * 100;

        let html = `<div class="line total"><span>Precio de venta${addIva ? ' (sin IVA)' : ''}</span><b>${money(price)}</b></div>`;
        html += `<div class="line"><span>Ganancia por unidad</span><b>${money(profit)}</b></div>`;
        html += `<div class="line"><span>Margen sobre el precio</span><b>${pctFmt(marginReal)}</b></div>`;
        html += `<div class="line"><span>Ganancia sobre el costo</span><b>${pctFmt(markupReal)}</b></div>`;
        if (addIva) {
          html += `<div class="line"><span>IVA (19%)</span><b>${money(price * IVA)}</b></div>`;
          html += `<div class="line total"><span>Precio final con IVA</span><b>${money(price * (1 + IVA))}</b></div>`;
        }

        result.innerHTML = html;
        result.hidden = false;
      }

      const form = document.getElementById('price-form');
      const result = document.getElementById('price-result');
      const hook = document.getElementById('hook');

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const cost = parseFloat(form.elements['cost'].value);
        const pct = parseFloat(form.elements['pct'].value);
        if (!Number.isFinite(cost) || cost <= 0 || !Number.isFinite(pct) || pct < 0) {
          result.innerHTML = '<div class="line"><span>Ingresa un costo y un porcentaje válidos.</span></div>';
          result.hidden = false;
          return;
        }
        renderResult(cost, form.elements['mode'].value, pct, form.elements['iva'].value === 'yes', result);
        hook.hidden = false;
      });

      const hookForm = document.getElementById('hook-form');
      const hookStatus = document.getElementById('hook-status');

      hookForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = hookForm.querySelector('button');
        button.disabled = true;
        hookStatus.textContent = 'Enviando...';
        try {
          const payload = {
            name: hookForm.elements['name'].value,
            email: hookForm.elements['email'].value,
            subject: 'Precio de venta — mi caso',
            message: hookForm.elements['message'].value,
            company: hookForm.elements['company'].value,
          };
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await response.json();
          if (response.ok && data.ok) {
            hookForm.reset();
            hookStatus.textContent = 'Listo, te respondo pronto. Gracias.';
          } else {
            hookStatus.textContent = 'No se pudo enviar. Inténtalo de nuevo en un momento.';
          }
        } catch {
          hookStatus.textContent = 'No se pudo enviar. Inténtalo de nuevo en un momento.';
        } finally {
          button.disabled = false;
        }
      });
    </script>

    <style is:global>
      :root {
        --paper: #f1f1ec; --paper-2: #eceae3; --ink: #17201b; --ink-soft: #5b625b;
        --line: #d5d4cb; --accent: #0f6e4e; --accent-ink: #0a4d36; --accent-soft: #e2ede7; --warn: #8a5109;
        --font-mono: 'IBM Plex Mono', ui-monospace, "Consolas", monospace;
        --font-sans: 'Archivo Variable', system-ui, -apple-system, "Segoe UI", sans-serif;
        --wrap: 780px;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { background: var(--paper); color: var(--ink); font-family: var(--font-sans); line-height: 1.6; -webkit-font-smoothing: antialiased; }

      .top { max-width: var(--wrap); margin: 0 auto; padding: 1.5rem clamp(1.25rem, 4vw, 2rem); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
      .brand { text-decoration: none; display: flex; align-items: center; gap: 0.55rem; }
      .brand-mark { display: inline-flex; color: var(--accent-ink); }
      .brand-mark svg { width: 20px; height: 20px; }
      .mark { font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.06em; color: var(--ink); font-size: 1rem; }
      .back { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--ink-soft); text-decoration: none; }
      .back:hover { color: var(--accent-ink); }

      .tool { max-width: var(--wrap); margin: 0 auto; padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 4vw, 2rem) 5rem; display: flex; flex-direction: column; gap: 2.5rem; }
      .eyebrow { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: var(--accent-ink); margin-bottom: 1rem; }
      h1 { font-size: clamp(1.9rem, 5vw, 2.7rem); color: var(--ink); line-height: 1.08; letter-spacing: -0.02em; margin-bottom: 1.1rem; font-weight: 800; text-wrap: balance; }
      .lead { font-size: 1.08rem; color: #2c332c; max-width: 60ch; }

      .rec-form { display: grid; gap: 1.1rem; background: #fff; border: 1px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); padding: 1.8rem; }
      .field { display: flex; flex-direction: column; gap: 0.4rem; }
      .field label { font-family: var(--font-mono); color: var(--ink-soft); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
      .field label span { text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
      input, select { font-family: var(--font-mono); padding: 0.7rem 0.8rem; background: var(--paper); border: 1px solid var(--line); color: var(--ink); font-size: 0.95rem; width: 100%; }
      input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
      button { font-family: var(--font-mono); padding: 0.85rem 1.4rem; background: var(--accent); color: #fff; border: none; font-weight: 600; font-size: 0.9rem; letter-spacing: 0.02em; cursor: pointer; transition: background 0.2s; justify-self: start; }
      button:hover:not(:disabled) { background: var(--accent-ink); }
      button:disabled { opacity: 0.6; cursor: not-allowed; }

      .rec-result { background: #fff; border: 1px solid var(--ink); padding: 1.5rem 1.8rem; margin-top: 1.4rem; }
      .rec-result .line { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
      .rec-result .line:last-child { border-bottom: none; }
      .rec-result .line span { color: var(--ink-soft); }
      .rec-result .line b { color: var(--ink); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
      .rec-result .total { margin-top: 0.2rem; padding-top: 0.6rem; border-top: 1px dashed var(--line) !important; font-size: 1.05rem; }
      .rec-result .total:first-child { margin-top: 0; padding-top: 0; border-top: none !important; }
      .rec-result .total b { color: var(--accent-ink); font-size: 1.15rem; }

      .hook { background: var(--accent-soft); border: 1px solid var(--accent); padding: 1.8rem; }
      .hook h2 { color: var(--accent-ink); font-size: 1.35rem; margin-bottom: 0.6rem; letter-spacing: -0.01em; }
      .hook p { color: #2c332c; }
      .hook-form { display: grid; gap: 0.9rem; margin-top: 1.2rem; }
      .hook-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
      .hook-form input, .hook-form textarea { background: #fff; border-color: var(--accent); }
      .hook-status { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-ink); min-height: 1.1rem; }
      .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

      .notes h2 { color: var(--ink); font-size: 1.2rem; margin-bottom: 1rem; letter-spacing: -0.01em; }
      .notes ul { padding-left: 1.2rem; display: grid; gap: 0.6rem; margin-bottom: 1.25rem; color: #2c332c; }
      .notes strong { color: var(--ink); }
      .disclaimer { font-size: 0.85rem; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 1rem; }

      .foot { max-width: var(--wrap); margin: 0 auto; padding: 1.5rem clamp(1.25rem, 4vw, 2rem) 3rem; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .foot p { color: var(--ink-soft); font-size: 0.86rem; flex: 1; min-width: 180px; }
      .foot-mono { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; color: var(--ink-soft); }

      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

      @media (max-width: 560px) { .hook-row { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
