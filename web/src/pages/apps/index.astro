---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Leaf } from 'lucide-astro';
import { apps } from '../../data/apps';

const otherApps = Object.values(apps);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Aplicaciones desarrolladas por GeosData" />
    <link rel="canonical" href="https://geosdata.com/apps/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>Mis Aplicaciones - GeosData</title>
  </head>
  <body>
    <Header currentPage="apps" />
    
    <main class="main">
      <section class="page-hero">
        <div class="container">
          <h1 class="page-title">Aplicaciones</h1>
          <p class="page-subtitle">
            Soluciones digitales que desarrollamos para resolver problemas reales.
          </p>
          <p class="page-count">{otherApps.length + 1} productos · en construcción</p>
        </div>
      </section>

      <section class="apps-section">
        <div class="container">
          <div class="apps-grid">
            <article class="app-card" style="--accent: #047857">
              <div class="app-head">
                <span class="app-icon" style="color: #047857"><Leaf size={26} /></span>
                <div class="app-headtext">
                  <h3 class="app-title">Ceiba</h3>
                  <p class="app-tagline">Asistente inteligente para plantas</p>
                </div>
              </div>
              <span class="app-status">Principal</span>
              <p class="app-description">
                App móvil que usa IA (GPT-4 Vision) para identificar plantas, diagnosticar problemas de salud y dar consejos de cuidado personalizados.
              </p>
              <div class="app-tech">
                <span class="tech-tag">Flutter</span>
                <span class="tech-tag">FastAPI</span>
                <span class="tech-tag">GPT-4</span>
                <span class="tech-tag">PostgreSQL</span>
                <span class="tech-tag">Redis</span>
              </div>
              <div class="app-actions">
                <a href="/apps/ceiba" class="btn btn-primary">Ver detalles →</a>
                <a href="#" class="btn btn-ghost">Demo</a>
              </div>
            </article>

            {otherApps.map((app) => (
              <article class="app-card" style={`--accent: ${app.accent}`}>
                <div class="app-head">
                  <span class="app-icon">{app.emoji}</span>
                  <div class="app-headtext">
                    <h3 class="app-title">{app.name}</h3>
                    <p class="app-tagline">{app.tagline}</p>
                  </div>
                </div>
                <span class="app-status">{app.status}</span>
                <p class="app-description">{app.description}</p>
                <div class="app-tech">
                  {app.techStack.map((t) => <span class="tech-tag">{t}</span>)}
                </div>
                <div class="app-actions">
                  <a href={`/apps/${app.slug}`} class="btn btn-primary">Conocer más →</a>
                  <a href={`/apps/${app.slug}#waitlist`} class="btn btn-ghost">Beta</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #030712;
    color: #94a3b8;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-hero {
    padding: 7rem 0 2.5rem;
    text-align: center;
    background: transparent;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: white;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    color: #94a3b8;
    max-width: 560px;
    margin: 0 auto;
  }

  .page-count {
    margin-top: 0.875rem;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: #64748b;
  }

  .apps-section {
    padding: 2.5rem 0 4rem;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .app-card {
    display: flex;
    flex-direction: column;
    background: #0b1120;
    border: 1px solid #1e293b;
    border-top: 2px solid var(--accent, #334155);
    border-radius: 10px;
    padding: 1.25rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .app-card:hover {
    border-color: #334155;
    border-top-color: var(--accent, #334155);
    background: #0d1424;
  }

  .app-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }

  .app-icon {
    font-size: 1.625rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .app-headtext {
    flex: 1;
    min-width: 0;
  }

  .app-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: white;
    line-height: 1.25;
  }

  .app-tagline {
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.35;
    margin-top: 0.125rem;
  }

  .app-status {
    display: block;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 0.875rem;
  }

  .app-status::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent, #334155);
    margin-right: 0.4375rem;
    vertical-align: middle;
  }

  .app-description {
    color: #94a3b8;
    line-height: 1.55;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    flex: 1;
  }

  .app-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.125rem;
  }

  .tech-tag {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    background: #0f172a;
    color: #64748b;
    padding: 0.1875rem 0.5rem;
    border-radius: 5px;
    font-size: 0.6875rem;
  }

  .app-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    text-decoration: none;
    border-radius: 7px;
    font-weight: 600;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    text-align: center;
    font-size: 0.8125rem;
  }

  .btn-primary {
    flex: 1;
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
  }

  .btn-primary:hover {
    background: #334155;
    border-color: #475569;
  }

  .btn-ghost {
    background: transparent;
    color: #94a3b8;
    border: 1px solid #1e293b;
  }

  .btn-ghost:hover {
    color: #e2e8f0;
    border-color: #334155;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 6rem 0 3rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .app-actions {
      flex-direction: column;
    }

    .btn {
      width: 200px;
    }
  }
</style>
