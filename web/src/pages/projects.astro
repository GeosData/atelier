---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Star, Leaf, MapPin, Bot, Smartphone, Construction, Link, Globe, BarChart3 } from 'lucide-astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Conoce cómo convertimos datos dispersos en decisiones claras para negocios. Juntamos tu información y te mostramos qué está funcionando." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://geosdata.com/projects" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Proyectos - GeosData" />
    <meta property="og:description" content="Conoce cómo convertimos datos dispersos en decisiones claras para negocios." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://geosdata.com/projects" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>GeosData - Proyectos</title>
  </head>
  <body>
    <Header currentPage="projects" />
    
    <main class="main">
      <section class="page-hero">
        <div class="hero-glow"></div>
        <div class="container">
          <h1 class="page-title">Nuestros Proyectos</h1>
          <p class="page-subtitle">
            Obras de arte tecnológicas, cada una una creación única de nuestro laboratorio de ideas
          </p>
        </div>
      </section>

      <section class="projects-section">
        <div class="container">
          <div class="projects-grid">
            <div class="project-card featured-project">
              <div class="featured-badge"><Star size={14} /> Proyecto Principal</div>
              <div class="project-image">
                <div class="project-placeholder ceiba-bg">
                  <span class="project-category"><Leaf size={16} /> Arte Digital</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Ceiba - Asistente Inteligente para Plantas</h3>
                <p class="project-description">
                  Aplicación móvil que utiliza inteligencia artificial (GPT-4 Vision) para identificar plantas, 
                  diagnosticar problemas de salud y proporcionar consejos personalizados de cuidado.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Flutter</span>
                  <span class="tech-tag">FastAPI</span>
                  <span class="tech-tag">OpenAI GPT-4</span>
                  <span class="tech-tag">PostgreSQL</span>
                </div>
                <div class="project-actions">
                  <a href="/apps/ceiba" class="project-link">Ver detalles →</a>
                </div>
              </div>
            </div>

            <div class="project-card featured-project">
              <div class="project-image">
                <div class="project-placeholder quehaypa-bg">
                  <span class="project-category"><MapPin size={16} /> Descubrimiento</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">QueHayPa — Descubre Lugares</h3>
                <p class="project-description">
                  Plataforma comunitaria que agrega posts de TikTok e Instagram sobre restaurantes, 
                  atracciones y eventos. Los usuarios descubren lugares mediante contenido social 
                  y los guardan para explorar después. Orientado al mercado latinoamericano.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Next.js 16</span>
                  <span class="tech-tag">React 19</span>
                  <span class="tech-tag">PostgreSQL</span>
                  <span class="tech-tag">Drizzle ORM</span>
                  <span class="tech-tag">Clerk Auth</span>
                  <span class="tech-tag">AI (Claude/GPT)</span>
                </div>
                <div class="project-actions">
                  <a href="https://quehaypa.com" target="_blank" class="project-link">Visitar quehaypa.com →</a>
                </div>
              </div>
            </div>

            <div class="project-card coming-soon">
              <div class="project-image">
                <div class="project-placeholder analytics-bg">
                  <span class="project-category"><Bot size={16} /> Laboratorio</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Sistema de Análisis de Imágenes IA</h3>
                <p class="project-description">
                  Integración de inteligencia artificial para análisis automático de imágenes de productos 
                  en investigación de mercados con reconocimiento visual avanzado.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Python</span>
                  <span class="tech-tag">OpenCV</span>
                  <span class="tech-tag">TensorFlow</span>
                  <span class="tech-tag">AWS</span>
                </div>
                <div class="project-status">
                  <span class="status-badge coming-soon-badge"><Construction size={12} /> En Desarrollo</span>
                </div>
              </div>
            </div>

            <div class="project-card coming-soon">
              <div class="project-image">
                <div class="project-placeholder mobile-bg">
                  <span class="project-category"><Smartphone size={16} /> Artesanía</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Campana ConnectApp</h3>
                <p class="project-description">
                  Aplicación móvil de encuestas para recolectar y sincronizar operaciones del sector 
                  de bienes y servicios con análisis de datos en tiempo real.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">React Native</span>
                  <span class="tech-tag">Node.js</span>
                  <span class="tech-tag">MongoDB</span>
                  <span class="tech-tag">AWS</span>
                </div>
                <div class="project-status">
                  <span class="status-badge coming-soon-badge"><Construction size={12} /> En Desarrollo</span>
                </div>
              </div>
            </div>

            <div class="project-card coming-soon">
              <div class="project-image">
                <div class="project-placeholder api-bg">
                  <span class="project-category"><Link size={16} /> Laboratorio</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">API de Facturación Electrónica</h3>
                <p class="project-description">
                  Solución para generación y validación de facturas electrónicas conforme a normativas 
                  nacionales con integración de sistemas contables.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Node.js</span>
                  <span class="tech-tag">Python</span>
                  <span class="tech-tag">PostgreSQL</span>
                  <span class="tech-tag">REST API</span>
                </div>
                <div class="project-status">
                  <span class="status-badge coming-soon-badge"><Construction size={12} /> En Desarrollo</span>
                </div>
              </div>
            </div>

            <div class="project-card coming-soon">
              <div class="project-image">
                <div class="project-placeholder web-bg">
                  <span class="project-category"><Globe size={16} /> Artesanía</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">App de Gestión Móvil</h3>
                <p class="project-description">
                  Aplicación móvil para gestionar inventarios y control de asistencias en campo 
                  con sincronización offline y reportes automatizados.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">React Native</span>
                  <span class="tech-tag">Firebase</span>
                  <span class="tech-tag">Redux</span>
                  <span class="tech-tag">PWA</span>
                </div>
                <div class="project-status">
                  <span class="status-badge coming-soon-badge"><Construction size={12} /> En Desarrollo</span>
                </div>
              </div>
            </div>

            <div class="project-card coming-soon">
              <div class="project-image">
                <div class="project-placeholder crm-bg">
                  <span class="project-category"><BarChart3 size={16} /> Laboratorio</span>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Dashboard de Análisis Inteligente</h3>
                <p class="project-description">
                  Sistema de visualización de datos con IA para análisis predictivo y 
                  reportes automatizados para toma de decisiones estratégicas.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Vue.js</span>
                  <span class="tech-tag">Python</span>
                  <span class="tech-tag">Machine Learning</span>
                  <span class="tech-tag">D3.js</span>
                </div>
                <div class="project-status">
                  <span class="status-badge coming-soon-badge"><Construction size={12} /> En Desarrollo</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="stats-section">
        <div class="container">
          <h2 class="section-title">Nuestros Logros</h2>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number">2</div>
              <div class="stat-label">Aplicaciones Lanzadas</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">5</div>
              <div class="stat-label">Proyectos en Desarrollo</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">100%</div>
              <div class="stat-label">Enfoque en IA + Tecnología</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">∞</div>
              <div class="stat-label">Pasión por la Innovación</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #030712;
    color: #94a3b8;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .main {
    min-height: calc(100vh - 200px);
  }

  .page-hero {
    position: relative;
    padding: 8rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: rgba(99, 102, 241, 0.2);
    filter: blur(100px);
    border-radius: 50%;
    opacity: 0.5;
    pointer-events: none;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: white;
    position: relative;
    z-index: 1;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .projects-section {
    padding: 4rem 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(30, 41, 59, 0.6);
    border-radius: 1.5rem;
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
  }

  .project-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-4px);
  }

  .featured-project {
    border-color: rgba(99, 102, 241, 0.5);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #4f46e5, #8b5cf6);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-image {
    height: 180px;
    position: relative;
    overflow: hidden;
  }

  .project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ceiba-bg {
    background: linear-gradient(135deg, #312e81 0%, #4338ca 100%);
  }

  .quehaypa-bg {
    background: linear-gradient(135deg, #3730a3 0%, #4f46e5 100%);
  }

  .analytics-bg {
    background: linear-gradient(135deg, #4c1d95 0%, #5b21b6 100%);
  }

  .mobile-bg {
    background: linear-gradient(135deg, #0e7490 0%, #0891b2 100%);
  }

  .api-bg {
    background: linear-gradient(135deg, #164e63 0%, #0e7490 100%);
  }

  .web-bg {
    background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 100%);
  }

  .crm-bg {
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  }

  .project-category {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: white;
  }

  .project-description {
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tech-tag {
    background: rgba(30, 41, 59, 0.6);
    color: #94a3b8;
    padding: 0.25rem 0.6rem;
    border-radius: 15px;
    font-size: 0.7rem;
    font-weight: 500;
  }

  .project-actions {
    margin-top: 0.5rem;
  }

  .project-link {
    color: #818cf8;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .project-link:hover {
    color: #c084fc;
  }

  .coming-soon {
    opacity: 0.7;
  }

  .project-status {
    margin-top: 1rem;
    text-align: center;
  }

  .status-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .coming-soon-badge {
    background: #f59e0b;
    color: #1a1a1a;
  }

  .stats-section {
    padding: 4rem 0 6rem;
    background: rgba(2, 6, 23, 0.5);
    border-top: 1px solid #0f172a;
  }

  .section-title {
    text-align: center;
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 3rem;
    color: white;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    text-align: center;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(30, 41, 59, 0.6);
    padding: 2rem;
    border-radius: 1.5rem;
    transition: all 0.3s ease;
  }

  .stat-item:hover {
    border-color: rgba(99, 102, 241, 0.4);
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: #818cf8;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    color: #64748b;
    font-weight: 500;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 6rem 0 3rem;
    }
    
    .page-title {
      font-size: 2.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
