---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';

const tools = [
  { label: 'Backend', items: ['Python', 'FastAPI', 'Node.js', 'PHP / Laravel', 'Django'] },
  { label: 'Datos', items: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'] },
  { label: 'Web y apps', items: ['Astro', 'Vue', 'React', 'React Native'] },
  { label: 'Nube y operación', items: ['AWS', 'Azure', 'Docker', 'CI/CD'] },
];

const diffs = [
  {
    title: 'Ves primero, pagas después',
    body: 'Antes de que te comprometas con nada, te muestro algo funcionando con el caso de tu negocio. Si no te sirve, no seguimos.',
  },
  {
    title: 'Hablas con quien construye',
    body: 'Una sola persona de punta a punta. Lo que me cuentas no pasa por tres manos antes de llegar al código: llega directo.',
  },
  {
    title: 'Productos que ya funcionan',
    body: 'No te vendo diapositivas. Tengo herramientas y apps en línea que puedes probar hoy mismo.',
    href: '/#taller',
    link: 'Ver los productos →',
  },
  {
    title: 'Te hablo claro',
    body: 'Nada de tecnicismos. Te explico qué se puede hacer, cómo y en cuánto, en palabras que se entienden.',
  },
];

const creds = ['6+ años en producción', 'Backend · APIs · datos', 'Productos propios en línea', 'Colombia · remoto'];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://geosdata.com/about" />
    <meta name="description" content="Detrás de Geosdata hay una sola persona: Josse, ingeniero de software con más de 6 años construyendo sistemas en producción. El mismo rigor de la empresa grande, al tamaño de tu negocio." />
    <meta property="og:title" content="Quién está detrás de Geosdata" />
    <meta property="og:description" content="El mismo rigor de la empresa grande, al tamaño de tu negocio. Diseño, construyo y opero yo mismo el software de tu negocio." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://geosdata.com/about" />
    <meta property="og:locale" content="es_CO" />
    <title>Geosdata — Quién está detrás</title>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="M3 13l9 5 9-5"/></svg></span>
          <span class="brand-text">
            <span class="mark">GEOSDATA</span>
            <span class="brand-sub">TALLER DIGITAL</span>
          </span>
        </a>
        <nav class="nav">
          <a href="/#medida">Para tu negocio</a>
          <a href="/#taller">Productos</a>
          <a href="/#como">Cómo trabajo</a>
          <a href="/#hook" class="nav-cta">Escríbeme</a>
        </nav>
      </header>

      <section class="who">
        <p class="eyebrow">Quién está detrás</p>
        <h1>Detrás de Geosdata hay una sola persona: yo.</h1>
        <p class="lead">
          Soy Jose Eduardo Tirado —Josse—, ingeniero de software con más de 6 años construyendo
          sistemas en producción. Diseño, construyo y opero yo mismo el software de tu negocio.
          Sin intermediarios, sin vendedores de por medio, sin un practicante aprendiendo con tu proyecto.
        </p>
        <div class="who-actions">
          <a href="/#hook" class="btn btn-primary">Cuéntame tu problema</a>
          <a href="/#taller" class="btn btn-ghost">Ver productos</a>
        </div>
        <ul class="creds">
          {creds.map((c) => <li>{c}</li>)}
        </ul>
      </section>

      <section class="block">
        <div class="section-head">
          <p class="eyebrow">De dónde vengo</p>
          <h2>El mismo rigor de la empresa grande, al tamaño de tu negocio</h2>
        </div>
        <div class="prose">
          <p>
            Durante años construí el backend de empresas de telecomunicaciones, investigación de
            mercados y consultoría tecnológica: sistemas que no se pueden caer y datos que tienen
            que cuadrar. Ese es el estándar con el que trabajo.
          </p>
          <p>
            La diferencia es que ese mismo cuidado —el que un banco o una telco pagan carísimo—
            lo pongo al servicio de una ferretería, una panadería o un consultorio. Tu negocio
            merece software que funcione bien de verdad, no una plantilla genérica.
          </p>
        </div>
        <!-- Opcional: confirma si quieres exponer estos nombres en el sitio comercial. -->
        <div class="worked">
          <span class="worked-label">Donde he trabajado</span>
          <div class="worked-tags">
            <span class="tag">WOM Colombia</span>
            <span class="tag">Dichter &amp; Neira</span>
            <span class="tag">Periferia IT Group</span>
            <span class="tag">Tata Consultancy Services</span>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="section-head">
          <p class="eyebrow">Por qué yo</p>
          <h2>Lo que me hace distinto</h2>
        </div>
        <div class="diff-grid">
          {diffs.map((d) => (
            <article class="diff-card">
              <h3>{d.title}</h3>
              <p>{d.body}</p>
              {d.href ? <a class="card-link" href={d.href}>{d.link}</a> : null}
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <div class="section-head">
          <p class="eyebrow">Con qué construyo</p>
          <h2>Las herramientas son el medio, no el fin</h2>
          <p class="section-lead">Uso lo que el problema pida. Para que tengas referencia, este es mi terreno.</p>
        </div>
        <div class="tools">
          {tools.map((g) => (
            <div class="tool-group">
              <span class="tool-label">{g.label}</span>
              <div class="tool-tags">
                {g.items.map((it) => <span class="tag">{it}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="hook">
        <div class="hook-copy">
          <h2>¿Tu negocio hace algo a mano que te gustaría dejar de hacer?</h2>
          <p>Cuéntame qué es. Lo miramos y te digo si se puede automatizar y cómo — sin compromiso.</p>
        </div>
        <a href="/#hook" class="btn btn-solid">Escríbeme</a>
      </section>

      <footer class="foot">
        <span class="mark">GEOSDATA</span>
        <p>Software a la medida para negocios pequeños, y productos que puedes probar hoy.</p>
        <span class="foot-mono">geosdata.com</span>
      </footer>
    </div>

    <style is:global>
      :root {
        --paper: #f1f1ec; --paper-2: #eceae3; --ink: #17201b; --ink-soft: #5b625b;
        --line: #d5d4cb; --accent: #0f6e4e; --accent-ink: #0a4d36; --accent-soft: #e2ede7; --warn: #8a5109; --muted: #6b7169;
        --font-mono: 'IBM Plex Mono', ui-monospace, "Consolas", monospace;
        --font-sans: 'Archivo Variable', system-ui, -apple-system, "Segoe UI", sans-serif;
        --wrap: 1120px;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { background: var(--paper); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; -webkit-font-smoothing: antialiased; overflow-x: hidden; }

      .page > section, .top, .foot { max-width: var(--wrap); margin-left: auto; margin-right: auto; padding-left: clamp(1.25rem, 4vw, 2.5rem); padding-right: clamp(1.25rem, 4vw, 2.5rem); }

      .mark { font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.06em; color: var(--ink); }
      .eyebrow { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 1rem; }
      .tag { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; padding: 0.3rem 0.6rem; border: 1px solid var(--line); color: var(--ink-soft); background: #fff; white-space: nowrap; }

      /* top nav — mirrors home */
      .top { display: flex; align-items: center; justify-content: space-between; padding-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); gap: 1rem; }
      .brand { text-decoration: none; display: flex; align-items: center; gap: 0.6rem; line-height: 1.1; }
      .brand .mark { font-size: 1.05rem; }
      .brand-mark { display: inline-flex; color: var(--accent-ink); }
      .brand-mark svg { width: 20px; height: 20px; }
      .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
      .brand-sub { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.22em; color: var(--ink-soft); margin-top: 0.2rem; }
      .nav { display: flex; align-items: center; gap: 1.4rem; }
      .nav a { text-decoration: none; color: var(--ink); font-size: 0.9rem; }
      .nav a:not(.nav-cta):hover { color: var(--accent-ink); }
      .nav a.nav-cta { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; padding: 0.5rem 0.85rem; background: var(--ink); color: var(--paper); }
      .nav a.nav-cta:hover { background: var(--accent-ink); }

      .btn { font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.03em; padding: 0.8rem 1.3rem; text-decoration: none; border: 1px solid var(--ink); transition: transform 0.15s, background 0.15s; display: inline-block; }
      .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn-primary:hover { background: var(--accent-ink); transform: translateY(-2px); }
      .btn-ghost { background: transparent; color: var(--ink); }
      .btn-ghost:hover { background: var(--paper-2); }
      .btn-solid { background: var(--accent-ink); color: #fff; border-color: var(--accent-ink); justify-self: start; }
      .btn-solid:hover { background: var(--ink); transform: translateY(-2px); }

      /* hero */
      .who { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: clamp(1.5rem, 4vw, 2.5rem); }
      .who h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 800; text-wrap: balance; margin-bottom: 1.4rem; max-width: 20ch; }
      .lead { font-size: 1.1rem; max-width: 60ch; color: #2c332c; }
      .who-actions { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
      .creds { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin-top: 2.2rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
      .creds li { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.04em; color: var(--ink-soft); position: relative; padding-left: 1rem; }
      .creds li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 7px; height: 7px; background: var(--accent); }

      /* generic block + section head */
      .block { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
      .section-head { padding-top: clamp(2.5rem, 6vw, 4rem); margin-bottom: 2rem; border-top: 1px solid var(--line); }
      .section-head h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); letter-spacing: -0.015em; }
      .section-lead { font-size: 1.02rem; color: var(--ink-soft); max-width: 60ch; margin-top: 0.9rem; text-wrap: pretty; }

      .prose { max-width: 66ch; display: flex; flex-direction: column; gap: 1.1rem; }
      .prose p { font-size: 1.05rem; color: #2c332c; }

      .worked { margin-top: 2rem; }
      .worked-label { display: block; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 0.7rem; }
      .worked-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

      /* differentiators */
      .diff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }
      .diff-card { border: 1px solid var(--line); background: #fff; padding: 1.4rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.55rem; transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s; }
      .diff-card:hover { transform: translateY(-4px); border-color: var(--ink); box-shadow: 6px 6px 0 var(--ink); }
      .diff-card h3 { font-size: 1.12rem; letter-spacing: -0.01em; }
      .diff-card p { font-size: 0.92rem; color: var(--ink-soft); flex: 1; }
      .card-link { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-ink); text-decoration: none; margin-top: 0.3rem; }
      .card-link:hover { text-decoration: underline; }

      /* tools */
      .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem 1.8rem; }
      .tool-group { display: flex; flex-direction: column; gap: 0.8rem; padding-top: 1rem; border-top: 2px solid var(--accent); }
      .tool-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
      .tool-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

      /* hook */
      .hook { margin-top: clamp(3rem, 6vw, 4.5rem); display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; background: var(--accent-soft); border: 1px solid var(--accent); padding: clamp(1.6rem, 4vw, 2.6rem); }
      .hook-copy h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); letter-spacing: -0.015em; color: var(--accent-ink); text-wrap: balance; }
      .hook-copy p { margin-top: 0.8rem; color: #2c332c; }

      /* foot */
      .foot { margin-top: clamp(3rem, 6vw, 4.5rem); margin-bottom: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .foot p { color: var(--ink-soft); font-size: 0.88rem; flex: 1; min-width: 200px; }
      .foot-mono { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; color: var(--ink-soft); }

      a:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .diff-card { transition: none; }
      }
      @media (max-width: 860px) {
        .diff-grid { grid-template-columns: 1fr; }
        .hook { grid-template-columns: 1fr; align-items: start; }
      }
      @media (max-width: 560px) {
        .brand-sub { display: none; }
        .nav { gap: 0.8rem; }
        .nav a:not(.nav-cta) { display: none; }
      }
    </style>
  </body>
</html>
